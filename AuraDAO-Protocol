                    <div class="bg-slate-900/50 p-4 rounded-xl border border-slate-800/80 space-y-4">
                        <div class="flex justify-between items-center text-xs">
                            <span class="text-slate-400 font-medium">Select Risk-Reward Strategy</span>
                            <span class="text-[10px] bg-brand-violet/20 text-brand-violet px-2 py-0.5 rounded font-bold">Smart Rebalancing</span>
