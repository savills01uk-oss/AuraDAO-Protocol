                    <div class="flex justify-between items-start mb-4">
                        <div>
                            <span class="text-[10px] bg-indigo-900/40 text-indigo-300 px-2 py-1 rounded font-bold tracking-wider uppercase">DECENTRALIZED NODE DELEGATION</span>
