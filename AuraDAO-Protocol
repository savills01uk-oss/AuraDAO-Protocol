    <!-- FIREBASE IMPORT SCRIPTS -->
    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-app.js";
        import { getAuth, signInAnonymously, signInWithCustomToken, onAuthStateChanged } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-auth.js";
        import { getFirestore, doc, setDoc, getDoc, collection, query, onSnapshot, addDoc, serverTimestamp } from "https://www.gstatic.com/firebasejs/11.6.1/firebase-firestore.js";

        // Environment Variables
        const appId = typeof __app_id !== 'undefined' ? __app_id : 'auradao-secure-protocol';
        const firebaseConfig = JSON.parse(__firebase_config);

        // State Management
        let appState = {
            walletConnected: false,
            liquidWallet: 520.50,
            totalStaked: 7500.00,
            totalInvested: 2400.00,
            stakingToken: 'USDC',
            investStrategy: 'alpha',
            calculatorTier: 'staking',
            totalEarningsAccumulated: 1.48201201,
            userId: null
        };

        // Initialize Firebase
        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        const db = getFirestore(app);

        // Export State & handlers to Global window scope
        window.appState = appState;
        window.setStakingToken = setStakingToken;
        window.setMaxStaking = setMaxStaking;
        window.calculateStakingRewards = calculateStakingRewards;
        window.submitStaking = submitStaking;
        window.setInvestStrategy = setInvestStrategy;
        window.setMaxInvest = setMaxInvest;
        window.calculateInvestmentRewards = calculateInvestmentRewards;
        window.submitInvestment = submitInvestment;
        window.setCalcTier = setCalcTier;
        window.updateCalculatorProjections = updateCalculatorProjections;
        window.askAIEngine = askAIEngine;
        window.triggerAICustomSearch = triggerAICustomSearch;
        window.toggleWalletConnect = toggleWalletConnect;
        window.dismissNotification = dismissNotification;

        // Initialize Auth FIRST (RULE 3)
        const initAuth = async () => {
            try {
                if (typeof __initial_auth_token !== 'undefined' && __initial_auth_token) {
                    await signInWithCustomToken(auth, __initial_auth_token);
                } else {
                    await signInAnonymously(auth);
                }
            } catch (err) {
                console.error("Cloud Auth Error: ", err);
                showToast("error", "Secure Cloud Handshake interrupted. Using locally protected fallback node.");
            }
        };

        // Track Auth State & Set Up Observers
        onAuthStateChanged(auth, async (user) => {
            if (user) {
                appState.userId = user.uid;
                document.getElementById('userIdLabel').innerText = user.uid;
                document.getElementById('walletBtnText').innerText = `Cloud Active (${user.uid.substring(0,6)}...)`;
                
                // Fetch existing cloud state or seed new state
                await syncAccountState();
                
                // Initialize Listeners now that authenticated user exists
                subscribeToGlobalTransactions();
                subscribeToAccountTransactions();
            } else {
                document.getElementById('walletBtnText').innerText = "Session Offline";
            }
        });

        // Sync and initialize account profile state document
        async function syncAccountState() {
            if (!auth.currentUser) return;
            const profileRef = doc(db, 'artifacts', appId, 'users', auth.currentUser.uid, 'profile', 'state');
            
            try {
                const docSnap = await getDoc(profileRef);
                if (docSnap.exists()) {
                    const data = docSnap.data();
                    appState.liquidWallet = data.liquidWallet ?? 520.50;
                    appState.totalStaked = data.totalStaked ?? 7500.00;
                    appState.totalInvested = data.totalInvested ?? 2400.00;
                    appState.totalEarningsAccumulated = data.totalEarningsAccumulated ?? 1.48201201;
                    showToast("info", "Cloud Synchronization Complete. Restored remote secure state.");
                } else {
                    // Seed initial user metrics to cloud
                    await setDoc(profileRef, {
                        liquidWallet: appState.liquidWallet,
                        totalStaked: appState.totalStaked,
                        totalInvested: appState.totalInvested,
                        totalEarningsAccumulated: appState.totalEarningsAccumulated,
                        updatedAt: serverTimestamp()
                    });
                }
                
                updateUIPortfolioLabels();
                document.getElementById('stakingMaxLabel').innerText = `$${appState.liquidWallet.toLocaleString('en-US', {minimumFractionDigits: 2})}`;
                
            } catch (err) {
                console.error("Error fetching secure state doc:", err);
            }
        }

        // Save Current State back to Firestore (RULE 1 Path Enforcement)
        async function persistAccountState() {
            if (!auth.currentUser) return;
            const profileRef = doc(db, 'artifacts', appId, 'users', auth.currentUser.uid, 'profile', 'state');
            document.getElementById('saveStatus').classList.remove('hidden');
            
            try {
                await setDoc(profileRef, {
                    liquidWallet: appState.liquidWallet,
                    totalStaked: appState.totalStaked,
                    totalInvested: appState.totalInvested,
                    totalEarningsAccumulated: appState.totalEarningsAccumulated,
                    updatedAt: serverTimestamp()
                });
            } catch (err) {
                console.error("Auto saving state failed:", err);
            }
        }

        // Subscribe to User Transactions (RULE 1 and RULE 2 Simple Queries)
        function subscribeToAccountTransactions() {
            if (!auth.currentUser) return;
            const txCollection = collection(db, 'artifacts', appId, 'users', auth.currentUser.uid, 'transactions');
            
            onSnapshot(txCollection, (snapshot) => {
                const tbody = document.getElementById('transactionTableBody');
                const placeholder = document.getElementById('emptyRowPlaceholder');
                
                if (snapshot.empty) {
                    if (placeholder) placeholder.style.display = 'table-row';
                    return;
                }
                
                if (placeholder) placeholder.style.display = 'none';
                
                // Clear active list (except elements not generated by db)
                tbody.innerHTML = '';
                
                snapshot.forEach((doc) => {
                    const item = doc.data();
                    const row = document.createElement('tr');
                    row.innerHTML = `
                        <td class="py-3 font-semibold text-white">${item.type || 'Consensus Action'}</td>
                        <td>${item.pool || 'Active Node'}</td>
                        <td class="mono-font font-semibold text-white">$${(item.amount || 0).toLocaleString('en-US', {minimumFractionDigits: 2})}</td>
                        <td class="text-brand-mint font-semibold">${item.yieldText || '0.05% Daily'}</td>
                        <td><span class="px-2 py-0.5 rounded bg-brand-mint/10 text-brand-mint text-[10px] font-bold">ACTIVE</span></td>
                    `;
                    tbody.appendChild(row);
                });
            }, (err) => {
                console.error("Account transactions snapshot error:", err);
            });
        }

        // Subscribe to Global Transactions to power real active metrics and consensus feeds
        function subscribeToGlobalTransactions() {
            if (!auth.currentUser) return;
            // Listening to general consensus activity (RULE 1 & 2 Simple Collection path)
            const globalColl = collection(db, 'artifacts', appId, 'public', 'data', 'global_actions');
            
            onSnapshot(globalColl, (snapshot) => {
                const container = document.getElementById('liveLogsContainer');
                
                // Set approximate total depositors count based on snapshot size + constant offset
                const mockDepositors = 4122 + snapshot.size;
                document.getElementById('depositorsCount').innerText = mockDepositors.toLocaleString();

                if (snapshot.empty) {
                    initLiveLogsFallback();
                    return;
                }

                container.innerHTML = '';
                snapshot.forEach((doc) => {
                    const data = doc.data();
                    const p = document.createElement('p');
                    p.className = "text-brand-indigo";
                    p.innerText = `[${new Date().toLocaleTimeString()}] NODE_EVENT: User ${data.userSnippet || 'Anonymous'} processed $${data.amount} stake.`;
                    container.appendChild(p);
                });
            }, (err) => {
                console.error("Global activities snapshot error:", err);
                initLiveLogsFallback();
            });
        }

        // Initialize Live Feed Fallback Logs if public stream is empty
        function initLiveLogsFallback() {
            const logs = [
                "INF_ROUTER: Cross-chain rebalancing scanning complete. Yield optimal.",
                "NET_VALIDATOR: Delegated block weight refreshed across 12 node channels.",
                "AI_AGENT: Scanned Curve Finance pools. Arbitrage delta matches parameters.",
                "YIELD_DISPATCH: Autocompounding rewards paid out to 4,810 wallets.",
                "SECURITY: Aura Safety Module (ASM) health checked. Locked ratio: 1.48x"
            ];
            const container = document.getElementById('liveLogsContainer');
            container.innerHTML = '';
            logs.forEach(l => {
                const p = document.createElement('p');
                p.innerText = `[${new Date().toLocaleTimeString()}] ${l}`;
                container.appendChild(p);
            });
        }

        // Execution Core
        window.addEventListener('load', () => {
            initAuth();
            startEarningsTick();
            updateCalculatorProjections();
        });

        function toggleWalletConnect() {
            if (!appState.walletConnected) {
                appState.walletConnected = true;
                showToast("success", "Decentralized Web3 Connection active on your anonymous platform credentials.");
            } else {
                appState.walletConnected = false;
                showToast("info", "Cloud session maintained. Visual connection disconnected.");
            }
        }

        // Live ticking balance accumulator to show continuous on-chain progress
        function startEarningsTick() {
            setInterval(() => {
                const step = 0.00000021; 
                appState.totalEarningsAccumulated += step;
                document.getElementById('earningsAccumulator').innerText = `+$${appState.totalEarningsAccumulated.toFixed(8)}`;
                
                const randomFluc = (Math.random() - 0.5) * 0.02;
                const totalBalance = appState.liquidWallet + appState.totalStaked + appState.totalInvested + appState.totalEarningsAccumulated + randomFluc;
                document.getElementById('portfolioValue').innerText = `$${totalBalance.toLocaleString('en-US', {minimumFractionDigits: 2, maximumFractionDigits: 2})}`;
            }, 1000);
        }

        function setStakingToken(token) {
            ['USDC', 'USDT', 'ETH'].forEach(t => {
                document.getElementById(`stakeToken_${t}`).className = "p-3 rounded-xl border border-slate-800 text-xs font-bold flex items-center justify-between transition-all hover:border-slate-700";
            });
            document.getElementById(`stakeToken_${token}`).className = "p-3 rounded-xl border border-brand-violet bg-brand-violet/10 text-xs font-bold flex items-center justify-between transition-all";
            appState.stakingToken = token;
            calculateStakingRewards();
        }

        function setMaxStaking() {
            document.getElementById('stakingAmountInput').value = appState.liquidWallet.toFixed(2);
            calculateStakingRewards();
        }

        function calculateStakingRewards() {
            const inputVal = parseFloat(document.getElementById('stakingAmountInput').value) || 0;
            const dailyReward = inputVal * 0.0005;
            document.getElementById('stakeDailyOutput').innerText = `$${dailyReward.toFixed(2)}`;
        }

        // Form Handlers & Explicit Validation for Staking ($500 Min)
        async function submitStaking() {
            const amount = parseFloat(document.getElementById('stakingAmountInput').value) || 0;
            
            if (amount < 500) {
                showToast("error", "Failed: Consensus Node Staking requires a minimum delegation of $500.00 to guarantee gas offset.");
                return;
            }

            if (amount > appState.liquidWallet) {
                showToast("error", `Inadequate Liquidity: Your liquid balance of $${appState.liquidWallet} is insufficient for this stake.`);
                return;
            }

            appState.liquidWallet -= amount;
            appState.totalStaked += amount;
            
            updateUIPortfolioLabels();

            // Store in Private Transactions (RULE 1 Path)
            try {
                if (auth.currentUser) {
                    const txCollection = collection(db, 'artifacts', appId, 'users', auth.currentUser.uid, 'transactions');
                    await addDoc(txCollection, {
                        type: `Staking Delegation (${appState.stakingToken})`,
                        pool: 'Consensus Node Validator',
                        amount: amount,
                        yieldText: "0.05% Daily",
                        timestamp: serverTimestamp()
                    });

                    // Store in Public Feed for live monitoring (RULE 1 Path)
                    const publicFeed = collection(db, 'artifacts', appId, 'public', 'data', 'global_actions');
                    await addDoc(publicFeed, {
                        userSnippet: auth.currentUser.uid.substring(0, 6),
                        amount: amount,
                        timestamp: serverTimestamp()
                    });
                }
                
                await persistAccountState();
                showToast("success", `Successfully delegated $${amount} to consensus nodes. Daily yield is now accruing.`);
            } catch (err) {
                console.error("Failed persisting transaction:", err);
            }

            document.getElementById('stakingAmountInput').value = "500";
            calculateStakingRewards();
        }

        function setInvestStrategy(strat) {
            ['alpha', 'beta', 'gamma'].forEach(s => {
                document.getElementById(`strat_${s}`).className = "p-3 text-left rounded-xl border border-slate-800 flex flex-col justify-between transition-all hover:border-slate-700";
            });
            document.getElementById(`strat_${strat}`).className = "p-3 text-left rounded-xl border border-brand-violet bg-brand-violet/10 flex flex-col justify-between transition-all";
            appState.investStrategy = strat;
            calculateInvestmentRewards();
        }

        function setMaxInvest() {
            document.getElementById('investmentAmountInput').value = appState.liquidWallet.toFixed(2);
            calculateInvestmentRewards();
        }

        function calculateInvestmentRewards() {
            const val = parseFloat(document.getElementById('investmentAmountInput').value) || 0;
            let dailyRate = 0.0008; 
            let apyLabel = "29.20%";
            
            if (appState.investStrategy === 'beta') {
                dailyRate = 0.0004;
                apyLabel = "14.60%";
            } else if (appState.investStrategy === 'gamma') {
                dailyRate = 0.0012;
                apyLabel = "43.80%";
            }
            
            const daily = val * dailyRate;
            document.getElementById('investDailyOutput').innerText = `$${daily.toFixed(2)}`;
            document.getElementById('investAPYOutput').innerText = `~${apyLabel}`;
        }

        // Form Handlers & Explicit Validation for Investments ($200 Min)
        async function submitInvestment() {
            const amount = parseFloat(document.getElementById('investmentAmountInput').value) || 0;
            
            if (amount < 200) {
                showToast("error", "Minimum Investment Limit: AI Quantitative vaults require a threshold of at least $200.00 to guarantee yield optimizations.");
                return;
            }

            if (amount > appState.liquidWallet) {
                showToast("error", `Inadequate Balance: Your available wallet holds only $${appState.liquidWallet}.`);
                return;
            }

            appState.liquidWallet -= amount;
            appState.totalInvested += amount;

            let dailyFreqText = "0.08% Daily";
            let strategyName = "Aura Alpha Edge Vault";
            if (appState.investStrategy === 'beta') {
                dailyFreqText = "0.04% Daily";
                strategyName = "Delta Neutral Index";
            } else if (appState.investStrategy === 'gamma') {
                dailyFreqText = "0.12% Daily (Var)";
                strategyName = "High Yield Arbitrage";
            }

            updateUIPortfolioLabels();

            // Persist locally & remotely
            try {
                if (auth.currentUser) {
                    const txCollection = collection(db, 'artifacts', appId, 'users', auth.currentUser.uid, 'transactions');
                    await addDoc(txCollection, {
                        type: strategyName,
                        pool: 'AI Rebalanced Index',
                        amount: amount,
                        yieldText: dailyFreqText,
                        timestamp: serverTimestamp()
                    });

                    const publicFeed = collection(db, 'artifacts', appId, 'public', 'data', 'global_actions');
                    await addDoc(publicFeed, {
                        userSnippet: auth.currentUser.uid.substring(0, 6),
                        amount: amount,
                        timestamp: serverTimestamp()
                    });
                }
                
                await persistAccountState();
                showToast("success", `Deposited $${amount} into ${strategyName}. Optimization live.`);
            } catch (err) {
                console.error("Cloud persistence error:", err);
            }

            document.getElementById('investmentAmountInput').value = "200";
            calculateInvestmentRewards();
        }

        function updateUIPortfolioLabels() {
            document.getElementById('totalStakedLabel').innerText = `$${appState.totalStaked.toLocaleString('en-US', {minimumFractionDigits: 2})}`;
            document.getElementById('totalInvestedLabel').innerText = `$${appState.totalInvested.toLocaleString('en-US', {minimumFractionDigits: 2})}`;
            document.getElementById('liquidWalletLabel').innerText = `$${appState.liquidWallet.toLocaleString('en-US', {minimumFractionDigits: 2})}`;
            document.getElementById('stakingMaxLabel').innerText = `$${appState.liquidWallet.toLocaleString('en-US', {minimumFractionDigits: 2})}`;
